; si.env template for batch netlisting:  si -batch -command netlist -cdslib ../cds.lib
; Best practice: copy the si.env that ADE writes into
;   <projectDir>/<cell>/spectre/schematic/netlist/si.env
; and only change lib/cell/view. Values below are a typical Spectre setup.
simLibName = "myLib"
simCellName = "myTb"
simViewName = "schematic"
simSimulator = "spectre"
simNotIncremental = 't
simReNetlistAll = nil
simViewList = '("spectre" "cmos_sch" "cmos.sch" "schematic" "veriloga" "ahdl")
simStopList = '("spectre")
simNetlistHier = 't
nlFormatterClass = 'spectreFormatter
nlCreateAmap = 't
nlDesignVarNameList = nil
simRunDirectory = "."
